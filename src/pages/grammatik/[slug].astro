---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GrammarSummary from '../../components/GrammarSummary.astro';

export async function getStaticPaths() {
  const grammatik = await getCollection('grammatik');

  return grammatik.map((grammar) => ({
    params: {
      slug: grammar.id,
    },
    props: {
      grammar,
    },
  }));
}

const { grammar } = Astro.props;
const { Content } = await render(grammar);
---

<BaseLayout title={grammar.data.title}>
  <div class="study-page">
    <a class="back-link" href={`${import.meta.env.BASE_URL}grammatik/`}>
      ← Grammatik
    </a>

    <header class="grammar-header">
      <h1>{grammar.data.title}</h1>

      {grammar.data.level && (
        <p class="grammar-level">
          {grammar.data.level}
        </p>
      )}
    </header>
    <GrammarSummary
  question="wen? / was?"
  function="Direktes Objekt"
  changes={[
    { from: 'der', to: 'den' },
    { from: 'ein', to: 'einen' },
  ]}
/>

    <div class="content">
      <Content />
    </div>
  </div>
</BaseLayout>