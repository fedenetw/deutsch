---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Üben">
  <h1>Üben</h1>

  <div class="box">
    <p>
      Whoa there! You're going too fast. This section is still a work in progress.
      Please slow down.
    </p>
    <img src={`${import.meta.env.BASE_URL}rate.png`}>
  </div>
</BaseLayout>

<style>
.box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;

  margin: 16px 0;
  padding: 14px 18px;
  color: #24292f;
  background: #f6f8fa;
  border: 1px dashed #afb8c1;
  border-radius: 8px;
}

p {
  margin: 0;
  font-size: 18px;
  line-height: 1.5;
  flex: 1;
}

img {
  width: 120px;
  height: 120px;
  object-fit: contain;
  flex-shrink: 0;
}
</style>